# API Key de Google Gemini - Obligatoria
# Obtén tu API Key gratis en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Variable legacy - para compatibilidad hacia atrás (opcional)
# VITE_GEMINI_API_KEY=

# Puerto del servidor (default: 80)
PORT=80

# Orígenes permitidos para CORS (default: localhost)
# Separa múltiples orígenes con comas
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# Entorno (development o production)
NODE_ENV=development

